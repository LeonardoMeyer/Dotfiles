#!/bin/bash
# Hex: abre/fecha o launcher do elifouts pelo SUPER sozinho.
# O teclado PRO aparece como dois teclados; se o atalho disparar duas vezes
# seguidas, o segundo toggle fecharia o launcher na hora. Aqui o repetido é ignorado.
f="${XDG_RUNTIME_DIR:-/tmp}/hex-launcher.t"
now=$(date +%s%N); last=$(cat "$f" 2>/dev/null || echo 0)
echo "$(date +%T.%N) $(( (now - last) / 1000000 ))ms" >> "${XDG_RUNTIME_DIR:-/tmp}/hex-launcher.log"
(( now - last < 1000000000 )) && exit 0
echo "$now" > "$f"
exec "$HOME/.config/hypr/utilities/shells.sh" launcher

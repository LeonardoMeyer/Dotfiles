       61: ("chuva fraca", "🌦"), 63: ("chuva", "🌧"), 65: ("chuva forte", "🌧"), 80: ("pancadas", "🌦"),
       81: ("pancadas", "🌧"), 82: ("temporal", "⛈"), 95: ("trovoadas", "⛈"), 96: ("trovoadas", "⛈"), 99: ("trovoadas", "⛈")}
DICAS = [
    ("SUPER + ESC", "esconde e traz de volta o Spotify"),
    ("SUPER + TAB", "visão geral de todas as áreas de trabalho"),

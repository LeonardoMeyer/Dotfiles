    ("ALT + TAB", "tela inicial do elifouts"),
]


def run(cmd, timeout=20, cwd=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)
        return p.stdout if p.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


FEEDS = {
    "bitcoin": ["https://livecoins.com.br/feed/", "https://cointelegraph.com/rss"],
    "tecnologia": ["https://tecnoblog.net/feed/", "https://canaltech.com.br/rss/"],
    "cyber": ["https://feeds.feedburner.com/TheHackersNews", "https://krebsonsecurity.com/feed/",
              "https://www.securityweek.com/feed/"],

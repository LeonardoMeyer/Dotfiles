<footer>Atalho do dia: <kbd>%(tip_k)s</kbd> %(tip_d)s · gerado %(gerado)s</footer>
</div></body></html>""" % {
        "bg": t["bg"], "fg": t["fg"], "accent": t["accent"], "dim": t["dim"], "wall": t["wall"],
        "nome": e(c["name"]), "n": c["edition"], "ear": ear_html, "cidade": e(c["city"]),
        "data_curta": day.strftime("%d/%m/%Y"),
        "data_longa": "%s, %d de %s de %d" % (DIAS[day.weekday()].capitalize(), day.day, MESES[day.month - 1], day.year),
        "lead_kicker": e(lead["kicker"]), "lead_title": e(lead["title"]), "lead_body": e(lead["body"]),
        "wx_ontem": wx("Ontem", w.get("ontem")), "wx_hoje": wx("Hoje", w.get("hoje")), "wx_amanha": wx("Amanhã", w.get("amanha")),
        "rest": rest, "commits": commits_html, "agents": agents_html, "focus": focus_html, "pac": pac_html,
        "pend": ("%d atualizações esperando hoje." % pend) if pend else "Sistema em dia.",
        "loose": loose, "tip_k": e(tip[0]), "tip_d": e(tip[1]),
        "btc": btc_html, "events": events_html,
        "palavra": palavra_html, "termo": termo_html, "pergunta": pergunta_html, "alta": alta_html,
        "n_btc": news(nw.get("bitcoin")), "n_tec": news(nw.get("tecnologia")), "n_cyber": news(nw.get("cyber")),
        "gerado": dt.datetime.now().strftime("%d/%m %H:%M"),
    }


def build(day):
    os.makedirs(OUT, exist_ok=True)
    os.makedirs(CACHE, exist_ok=True)
    start, end = day_bounds(day)
    cfg = config()
    repos = find_repos()
    seen, commits = set(), []
    for cm in local_commits(repos, start, end) + github_commits(day):
        if cm["sha"] not in seen:
            seen.add(cm["sha"])
            commits.append(cm)
    c = {
        "date": day.isoformat(), "name": cfg.get("nome") or first_name(), "city": cfg["cidade"],
        "commits": commits, "agents": claude_sessions(start, end), "focus": focus(start, end),
        "pacman": pacman_day(day), "scan": sistema_scan(), "dirty": dirty_repos(repos),
        "weather": weather(cfg, day), "theme": theme(),
        "news": {k: news_section(v, start - dt.timedelta(hours=12)) for k, v in cfg["feeds"].items()},
        "btc": bitcoin_price(), "events": events(cfg["eventos"]), "hoje": para_hoje(cfg, day + dt.timedelta(days=1)),
        "edition": len(glob.glob(os.path.join(OUT, "????-??-??.html"))) + (0 if os.path.exists(os.path.join(OUT, day.isoformat() + ".html")) else 1),
    }
    c["stories"] = stories(c)
    path = os.path.join(OUT, day.isoformat() + ".html")
    with open(path + ".tmp", "w") as f:
        f.write(render(c))
    os.replace(path + ".tmp", path)

    w = c["weather"] or {}
    summary = {"date": day.isoformat(), "path": path, "edition": c["edition"], "stories": c["stories"][:3],
               "today": w.get("hoje"), "city": c["city"], "built": int(dt.datetime.now().timestamp()),
               "btc": c["btc"], "events": c["events"][:3],
               "palavra": c["hoje"]["palavra"], "pergunta": c["hoje"]["pergunta"],
               "em_alta": c["hoje"]["em_alta"][:2],
               "headlines": {k: v[:2] for k, v in c["news"].items()}}
    with open(os.path.join(CACHE, "latest.json.tmp"), "w") as f:
        json.dump(summary, f)
    os.replace(os.path.join(CACHE, "latest.json.tmp"), os.path.join(CACHE, "latest.json"))
    return summary


def main(a):
    if a and a[0] == "build":
        day = dt.date.fromisoformat(a[1]) if len(a) > 1 else dt.date.today() - dt.timedelta(days=1)
        print(json.dumps(build(day)))
    elif a and a[0] == "latest":
        try:
            with open(os.path.join(CACHE, "latest.json")) as f:
                print(f.read())
        except OSError:
            print("{}")
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])

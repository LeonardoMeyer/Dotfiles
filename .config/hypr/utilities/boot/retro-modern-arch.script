# Palette values are prepended by install.sh from the last saved Pywal palette.
# The card image come from generate-assets.py; keep layout numbers in sync.
Window.SetBackgroundTopColor (wal0R*0.5, wal0G*0.5, wal0B*0.5);
Window.SetBackgroundBottomColor (wal0R*0.5, wal0G*0.5, wal0B*0.5);

w = Window.GetWidth(); h = Window.GetHeight();
sx = w / 1920; sy = h / 1080;
scale = sx; if (sy < scale) scale = sy;

CARD_W = 960; CARD_H = 548; MARGIN = 90; PAD = 56;
cardX = Math.Int((w - CARD_W*scale) / 2);
cardY = Math.Int((h - CARD_H*scale) / 2);

fun scaled (img, f) {
  local.tw = Math.Int(img.GetWidth() * f); local.th = Math.Int(img.GetHeight() * f);
  if (tw < 1) tw = 1; if (th < 1) th = 1;
  return img.Scale(tw, th);
}
fun mktext (s, r, g, b, a, font) {
  return Image.Text(s, r, g, b, a, font);
}
fun ease (t) { return 0.5 - 0.5 * Math.Cos(Math.Pi * t); }

fadeItems = []; fadeBase = []; fadeCount = 0;
fun add_fade (sprite, base) {
  fadeItems[fadeCount] = sprite; fadeBase[fadeCount] = base; fadeCount += 1;
  sprite.SetOpacity(0);
}
fun apply_fade (a) {
  local.i = 0;
  while (i < fadeCount) { fadeItems[i].SetOpacity(fadeBase[i] * a); i += 1; }
}

# Card (includes its shadow margin)
cardImage = scaled(Image("assets/card.png"), scale);
card = Sprite(cardImage);
card.SetPosition(cardX - Math.Int(MARGIN*scale), cardY - Math.Int(MARGIN*scale), 1);
add_fade(card, 1);

fontSize = Math.Int(15 * scale); if (fontSize < 6) fontSize = 6;
monoFont = "Monospace " + fontSize;
bigSize = Math.Int(20 * scale); if (bigSize < 6) bigSize = 6;
pctFont = "Monospace Bold " + bigSize;

# Terminal lines
logX = cardX + Math.Int(108*scale);
logY1 = cardY + Math.Int(274*scale);
logY2 = cardY + Math.Int(320*scale);
maxLogW = Math.Int((CARD_W - 108 - PAD - 12) * scale);

line1Text = " "; line2Text = "starting system...";
line1 = Sprite(mktext(line1Text, wal7R, wal7G, wal7B, 0.55, monoFont));
line1.SetPosition(logX, logY1, 5);
add_fade(line1, 1);
line2 = Sprite(mktext(line2Text, wal15R, wal15G, wal15B, 1, monoFont));
line2.SetPosition(logX, logY2, 5);
add_fade(line2, 1);

# Percent, right aligned with the card padding
percentRight = cardX + Math.Int((CARD_W - PAD)*scale);
percentY = cardY + Math.Int(70*scale);
percent = Sprite();
add_fade(percent, 1);
percentShown = -1;
fun show_percent (value) {
  local.n = Math.Int(value*100);
  if (n == percentShown) return;
  percentShown = n;
  local.txt = "--%";
  if (has_progress) txt = "" + n + "%";
  local.img = mktext(txt, wal15R, wal15G, wal15B, 1, pctFont);
  percent.SetImage(img);
  percent.SetPosition(percentRight - img.GetWidth(), percentY, 5);
}

# ASCII progress bar: '-' track, '#' fill, same monospace cell width
barFont = pctFont;
fun repeat (ch, n) {
  local.t = ""; local.i = 0;
  while (i < n) { t = t + ch; i += 1; }
  return t;
}
barX = cardX + Math.Int(PAD*scale);
barY = cardY + Math.Int(402*scale);
barMaxW = Math.Int((CARD_W - 2*PAD) * scale);
cellW = Image.Text("################################", 1, 1, 1, 1, barFont).GetWidth() / 32;
if (cellW < 1) cellW = 1;
cells = Math.Int(barMaxW / cellW);
sweepCells = 8;

track = Sprite(mktext(repeat("-", cells), wal8R, wal8G, wal8B, 0.7, barFont));
track.SetPosition(barX, barY, 3);
add_fade(track, 1);
fill = Sprite(); fill.SetPosition(-4000, barY, 4);
add_fade(fill, 1);
sweepImage = mktext(repeat("#", sweepCells), wal13R, wal13G, wal13B, 1, barFont);
sweep = Sprite(sweepImage); sweep.SetPosition(-4000, barY, 4);
add_fade(sweep, 1);

progress = 0.0; shown = 0.0; has_progress = 0; phase = 0.0; fadeT = 0.0; shownCells = -1;
show_percent(0);

fun update_bar (value) {
  local.k = Math.Int(cells * value);
  if (value > 0 && k < 1) k = 1;
  if (k == shownCells) return;
  shownCells = k;
  if (k < 1) { fill.SetPosition(-4000, barY, 4); return; }
  fill.SetImage(mktext(repeat("#", k), wal13R, wal13G, wal13B, 1, barFont));
  fill.SetPosition(barX, barY, 4);
}

fun set_progress (duration, value) {
  progress = value;
  if (progress < 0) progress = 0;
  if (progress > 1) progress = 1;
  has_progress = 1;
}

# Measures the rendered text so the line never spills out of the terminal panel.
fun fit (s) {
  local.t = s;
  if (t == "") t = " ";
  local.n = 0;
  while (n < 6) {
    local.str = String(t);
    local.len = str.Length();
    local.img = mktext(t, 1, 1, 1, 1, monoFont);
    local.iw = img.GetWidth();
    if (iw <= maxLogW || len <= 8) return t;
    local.keep = Math.Int(len * maxLogW / iw) - 3;
    if (keep >= len - 3) keep = len - 4;
    if (keep < 5) keep = 5;
    t = str.SubString(0, keep) + "...";
    n += 1;
  }
  return t;
}
fun set_message (message) {
  if (message == "") return;
  line1Text = line2Text;
  line2Text = fit(message);
  line1.SetImage(mktext(line1Text, wal7R, wal7G, wal7B, 0.55, monoFont));
  line2.SetImage(mktext(line2Text, wal15R, wal15G, wal15B, 1, monoFont));
}

fun refresh_callback () {
  if (fadeT < 1) {
    fadeT += 0.04;
    if (fadeT > 1) fadeT = 1;
    apply_fade(ease(fadeT));
  }
  if (has_progress && progress > 0) {
    sweep.SetPosition(-4000, barY, 4);
    shown += (progress - shown) * 0.1;
    if (Math.Abs(progress - shown) < 0.0008) shown = progress;
    update_bar(shown);
    show_percent(shown);
  } else {
    phase += 0.007;
    if (phase > 1) phase = 0;
    local.idx = Math.Int((cells - sweepCells) * (0.5 - 0.5 * Math.Cos(2 * Math.Pi * phase)));
    local.x = barX + Math.Int(idx * cellW);
    sweep.SetPosition(x, barY, 4);
  }
}

Plymouth.SetBootProgressFunction(set_progress);
Plymouth.SetMessageFunction(set_message);
Plymouth.SetRefreshFunction(refresh_callback);

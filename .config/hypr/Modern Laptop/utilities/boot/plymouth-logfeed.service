[Unit]
Description=Show live system log lines on the Plymouth splash
DefaultDependencies=no
After=plymouth-start.service systemd-journald.service
Before=plymouth-quit.service plymouth-quit-wait.service

[Service]
Type=simple
ExecStart=/usr/local/bin/plymouth-logfeed
KillMode=control-group
TimeoutStopSec=2
Nice=10

[Install]
WantedBy=sysinit.target
